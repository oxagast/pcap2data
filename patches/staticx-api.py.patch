# require-import: staticx
# python: os.path.dirname(staticx.__file__)
#
# This patch works around an upstream bug in staticx 0.14.x: the
# bootloader-identify probe calls ``r.check_returncode()`` on the
# result of running the bootloader with ``STATICX_BOOTLOADER_IDENTIFY=1``,
# but the bootloader intentionally exits with status 2 in identify
# mode (no archive attached; that's the documented protocol). The
# patch tolerates exit codes 0 and 2 and re-raises ``CalledProcessError``
# for any other failure so genuine loader errors still surface.
#
# The patch is keyed on the ``STATICX_BOOTLOADER_IDENTIFY_PATCH_APPLIED``
# sentinel comment, which the applier (``scripts/apply-patches.js``)
# uses for idempotency.
#
# Regenerate from upstream with::
#
#     python3 -c "import sys; sys.path.insert(0, '/path/to/staticx-0.14.2'); ..." # see /memories/repo/staticx_backend_build.md
--- api.py
+++ api.py
@@ -87,14 +87,24 @@
             raise FormatMismatchError(
                 f"Bootloader machine ({bldr_mach}) doesn't match program machine ({prog_mach})")
 
+        # STATICX_BOOTLOADER_IDENTIFY_PATCH_APPLIED: tolerate exit code 2 from the bootloader identify probe.
         # Run the bootloader for identification
+        # The bootloader intentionally exits with status 2 in identify
+        # mode (no archive attached; that's how it identifies itself).
+        # staticx 0.14.x calls ``r.check_returncode()`` here, which
+        # raises ``CalledProcessError`` on every build. Until upstream
+        # is fixed we tolerate exit codes 0 and 2 and re-raise for any
+        # other failure so genuine loader errors still surface.
         r = subprocess.run(
                 args = [bootloader],
                 env = dict(STATICX_BOOTLOADER_IDENTIFY='1'),
                 stderr = subprocess.PIPE,
                 text = True,
                 )
-        r.check_returncode()
+        if r.returncode not in (0, 2):
+            raise subprocess.CalledProcessError(
+                r.returncode, r.args, output=r.stdout, stderr=r.stderr,
+            )
         lines = (line.split(':', 1)[1].strip() for line in r.stderr.splitlines())
         logging.debug("Bootloader: " + " ".join(lines))