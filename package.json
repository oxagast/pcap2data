{
  "name": "packetsnitch",
  "executableName": "packetsnitch",
  "productName": "packetsnitch",
  "version": "1.9.1529",
  "description": "A High Level Network Analysis Tool",
  "homepage": "https://packetsnitch.com",
  "main": ".webpack/main",
  "private": false,
  "scripts": {
    "start": "electron-forge start -- --ozone-platform=x11",
    "package": "npm run build-backend && electron-forge package",
    "patch-rpm-build": "patch -Np0 < patches/spec.ejs.patch",
    "make": "npm run build-backend && cross-env QA_SKIP_RPATHS=1 electron-forge make",
    "build-backend": "pip3 install -r src/backend/requirements.txt --break-system-packages && python3 -m PyInstaller -y --distpath src/backend snitch.spec",
    "publish": "cross-env QA_SKIP_RPATHS=1 electron-forge publish",
    "test:backend": "pytest tests/test_backend_compile.py tests/test_backend_json.py tests/test_backend_server.py --maxfail=1",
    "test:frontend": "jest --runInBand",
    "tests": "npm run test:backend && npm run test:frontend"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oxagast/PacketSnitch"
  },
  "publishConfig": {
    "@oxagast:registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=12.11.0"
  },
  "keywords": [
    "packet sniffer",
    "network analysis",
    "network monitoring",
    "packet capture",
    "protocol analysis",
    "traffic analysis",
    "network security",
    "packets",
    "networking",
    "cybersecurity",
    "network troubleshooting",
    "network performance",
    "network diagnostics",
    "network forensics",
    "network visualization",
    "network management",
    "pcap decoder",
    "pcapng decoder",
    "packet inspector"
  ],
  "author": {
    "name": "Marshall Whittaker",
    "email": "marshall@oxasploits.com"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "electron": "^40.6.1",
    "electron-icon-maker": "^0.0.5",
    "globals": "^17.5.0",
    "jest": "^30.4.2",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "bson": "^7.3.1",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "crypto-js": "^4.2.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "fs": "^0.0.1-security",
    "heatmap.js": "^2.0.5",
    "js-sha3": "^0.9.3",
    "jsonparse": "^1.3.1",
    "lzma-native": "^8.0.6",
    "marked": "^18.0.5",
    "ollama": "^0.6.3",
    "openpgp": "^5.11.3",
    "prettier": "^3.9.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "undici": "^6.27.0",
    "vm-browserify": "^1.1.2",
    "whirlpool-js": "^1.0.0"
  },
  "plugins": [
    [
      "@electron-forge/plugin-webpack",
      {
        "mainConfig": "./webpack.main.config.js",
        "renderer": {
          "config": "./webpack.renderer.config.js",
          "entryPoints": [
            {
              "html": "./src/index.html",
              "js": "./src/renderer.js",
              "name": "main_window",
              "devContentSecurityPolicy": "default-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com 'unsafe-inline' data:;  worker-src 'self' blob:;"
            }
          ]
        }
      }
    ]
  ]
}
