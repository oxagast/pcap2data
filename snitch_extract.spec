# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec for the small archive helper bundled next to ``snitch``.
# Built by ``scripts/build-extractor.js`` so paths in the spec never get
# committed back into the repo (matching the build-backend.js rationale).

a = Analysis(
    ['snitch_extract.py'],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='snitch-extract',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
